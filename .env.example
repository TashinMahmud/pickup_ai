# ── Docker / Registry ────────────────────────────────
DOCKER_USERNAME=your-docker-username
PACKAGE_NAME=pickup-ai
VERSION=latest

# ── Provider Selection ──────────────────────────────
# Change this ONE word to switch the entire AI engine
MODEL_PROVIDER=openai          # openai | gemini | anthropic

# ── API Keys (only the active provider's key is needed)
OPENAI_API_KEY=sk-your-key-here
GEMINI_API_KEY=your-gemini-key-here

# ── Model Config ────────────────────────────────────
# Set MODEL_NAME to any model from your chosen provider:
#
#   OpenAI:    gpt-4o-mini | gpt-4o | gpt-4-turbo
#   Gemini:    gemini-1.5-flash | gemini-2.5-flash-preview-05-20 | gemini-2.0-flash
#   Anthropic: claude-3-5-haiku-latest | claude-3-5-sonnet-latest
#
MODEL_NAME=gpt-4o-mini
MODEL_TEMPERATURE=0.2

# ── Database ────────────────────────────────────────
# Docker Compose: use host "db". Local dev: use "localhost"
DATABASE_URL=postgresql://pickup:pickup_secret@db:5432/pickup_ai
PORT=8000
